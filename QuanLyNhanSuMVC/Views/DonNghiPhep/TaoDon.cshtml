@model QuanLyNhanSuMVC.Models.DonNghiPhepModel

@{
    ViewData["Title"] = "Tạo đơn nghỉ phép";
}

<div class="container mt-4">
    <h2>Tạo đơn nghỉ phép</h2>

    @if (TempData["ThongBao"] != null)
    {
        <div class="alert alert-info">
            @TempData["ThongBao"]
        </div>
    }

    <form asp-action="TaoDon" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="NgayBatDauNghi" class="form-label">
                Ngày bắt đầu nghỉ
            </label>
            <input asp-for="NgayBatDauNghi"
                   type="date" class="form-control" />
            <span asp-validation-for="NgayBatDauNghi"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="NgayKetThucNghi" class="form-label">
                Ngày kết thúc nghỉ
            </label>
            <input asp-for="NgayKetThucNghi"
                   type="date" class="form-control" />
            <span asp-validation-for="NgayKetThucNghi"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="LyDoNghi" class="form-label">
                Lý do nghỉ
            </label>
            <textarea asp-for="LyDoNghi"
                      class="form-control"
                      rows="4"></textarea>
            <span asp-validation-for="LyDoNghi"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Nộp Đơn
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Danh sách đơn
        </a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
