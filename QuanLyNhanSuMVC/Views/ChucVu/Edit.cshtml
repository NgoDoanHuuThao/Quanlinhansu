@model QuanLyNhanSuMVC.Models.ChucVuModel

@{
    ViewData["Title"] = "Sửa chức vụ";
}

<h1>✏️ Sửa chức vụ</h1>

@if (!string.IsNullOrEmpty(ViewBag.Error))
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<form asp-action="Edit"
      asp-route-id="@Model.ChucVuId"
      method="post">

    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label">
            ID chức vụ
        </label>

        <input value="@Model.ChucVuId"
               class="form-control"
               readonly />
    </div>

    <div class="mb-3">
        <label asp-for="TenChucVu"
               class="form-label">
            Tên chức vụ
        </label>

        <input asp-for="TenChucVu"
               class="form-control"
               required />

        <span asp-validation-for="TenChucVu"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MoTa"
               class="form-label">
            Mô tả
        </label>

        <textarea asp-for="MoTa"
                  class="form-control"
                  rows="4"></textarea>
    </div>

    <button type="submit"
            class="btn btn-primary">
        💾 Cập nhật
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        ← Quay lại
    </a>

</form>