@model List<QuanLyNhanSuMVC.Models.NhanVienModel>

@{
    ViewData["Title"] = "Quản lý nhân viên";
}

<style>
    body {
        background: #f4f7fb;
    }

    .employee-page {
        padding: 30px;
    }

    .page-header {
        background: linear-gradient(135deg, #2563eb, #4f46e5);
        color: white;
        border-radius: 18px;
        padding: 25px 30px;
        margin-bottom: 25px;
        box-shadow: 0 8px 25px rgba(37, 99, 235, 0.18);
    }

    .page-header h1 {
        margin: 0;
        font-size: 30px;
        font-weight: 700;
    }

    .page-header p {
        margin: 8px 0 0;
        opacity: 0.9;
    }

    .toolbar {
        background: white;
        padding: 18px;
        border-radius: 15px;
        margin-bottom: 20px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }

    .btn-custom {
        border: none;
        border-radius: 10px;
        padding: 10px 18px;
        text-decoration: none;
        display: inline-block;
        font-weight: 600;
        transition: 0.2s;
    }

    .btn-custom:hover {
        transform: translateY(-2px);
        text-decoration: none;
    }

    .btn-add {
        background: #16a34a;
        color: white;
    }

    .btn-home {
        background: #64748b;
        color: white;
    }

    .table-card {
        background: white;
        border-radius: 18px;
        overflow-x: auto;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.07);
    }

    .employee-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 1100px;
    }

    .employee-table thead {
        background: #1e293b;
        color: white;
    }

    .employee-table th {
        padding: 16px 14px;
        text-align: left;
        font-size: 14px;
        white-space: nowrap;
    }

    .employee-table td {
        padding: 15px 14px;
        border-bottom: 1px solid #e5e7eb;
        vertical-align: middle;
    }

    .employee-table tbody tr {
        transition: 0.2s;
    }

    .employee-table tbody tr:hover {
        background: #f8fafc;
    }

    .employee-id {
        font-weight: 700;
        color: #2563eb;
    }

    .employee-name {
        font-weight: 700;
        color: #1e293b;
    }

    .gender {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
    }

    .gender-male {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .gender-female {
        background: #fce7f3;
        color: #be185d;
    }

    .department {
        background: #f1f5f9;
        padding: 6px 10px;
        border-radius: 8px;
        display: inline-block;
        font-size: 13px;
    }

    .position {
        color: #475569;
        font-weight: 600;
    }

    .salary {
        font-weight: 700;
        color: #16a34a;
        white-space: nowrap;
    }

    .empty-message {
        padding: 40px;
        text-align: center;
        color: #64748b;
    }

    .error-message {
        background: #fee2e2;
        color: #b91c1c;
        padding: 15px;
        border-radius: 10px;
        margin-bottom: 20px;
    }

    @@media (max-width: 768px) {
        .employee-page {
            padding: 15px;
        }

        .page-header h1 {
            font-size: 24px;
        }

        .toolbar {
            flex-direction: column;
            align-items: stretch;
        }

        .btn-custom {
            text-align: center;
        }
    }
</style>

<div class="employee-page">

    <!-- HEADER -->
    <div class="page-header">
        <h1>👨‍💼 Quản lý nhân viên</h1>
        <p>Quản lý thông tin và hồ sơ nhân viên trong hệ thống</p>
    </div>

    <!-- ERROR -->
    @if (ViewBag.Error != null)
    {
        <div class="error-message">
            ⚠️ @ViewBag.Error
        </div>
    }

    <!-- TOOLBAR -->
    <div class="toolbar">

        <a asp-controller="Home"
           asp-action="Index"
           class="btn-custom btn-home">
            ← Về trang chủ
        </a>

        <a asp-action="Create"
           class="btn-custom btn-add">
            ➕ Thêm nhân viên
        </a>
        

    </div>

    <!-- TABLE -->
    <div class="table-card">

        @if (Model != null && Model.Any())
        {
            <table class="employee-table">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nhân viên</th>
                        <th>Ngày sinh</th>
                        <th>Giới tính</th>
                        <th>Số điện thoại</th>
                        <th>Email</th>
                        <th>Phòng ban</th>
                        <th>Chức vụ</th>
                        <th>Lương cơ bản</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                <span class="employee-id">
                                    #@item.NhanVienId
                                </span>
                            </td>

                            <td>
                                <span class="employee-name">
                                    @item.HoTen
                                </span>
                            </td>

                            <td>
                                @(item.NgaySinh?.ToString("dd/MM/yyyy") ?? "-")
                            </td>

                            <td>
                                @if (item.GioiTinh == "Nam")
                                {
                                    <span class="gender gender-male">
                                        👨 Nam
                                    </span>
                                }
                                else if (item.GioiTinh == "Nữ")
                                {
                                    <span class="gender gender-female">
                                        👩 Nữ
                                    </span>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>

                            <td>
                                @item.SoDienThoai
                            </td>

                            <td>
                                @item.Email
                            </td>

                            <td>
                                <span class="department">
                                    🏢 @item.TenPhongBan
                                </span>
                            </td>

                            <td>
                                <span class="position">
                                    @item.TenChucVu
                                </span>
                            </td>

                            <td>
                                <span class="salary">
                                    @(item.LuongCoBan?.ToString("N0") ?? "0") ₫
                                </span>
                            </td>
                            <td>
    <a asp-action="Edit"
       asp-route-id="@item.NhanVienId"
       class="btn btn-warning btn-sm">
        ✏️ Sửa
    </a>

    <a asp-action="Delete"
       asp-route-id="@item.NhanVienId"
       class="btn btn-danger btn-sm">
        🗑️ Xóa
    </a>
</td>

                        </tr>
                    }

                </tbody>

            </table>
        }
        else
        {
            <div class="empty-message">
                <h3>📭 Chưa có nhân viên</h3>
                <p>Hãy thêm nhân viên đầu tiên vào hệ thống.</p>

                <a asp-action="Create"
                   class="btn-custom btn-add">
                    ➕ Thêm nhân viên
                </a>
            </div>
        }

    </div>

</div>