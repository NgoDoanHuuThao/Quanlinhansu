@model List<QuanLyNhanSuMVC.Models.LichSuChamCongModel>

@{
    ViewData["Title"] = "Lịch sử chấm công";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h2 class="fw-bold">
            <i class="bi bi-calendar-check"></i>
            Lịch sử chấm công
        </h2>
        <p class="text-muted mb-0">
            Theo dõi lịch sử chấm công của nhân viên
        </p>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <button type="button"
        class="btn btn-outline-secondary"
        onclick="quayLai()">
    <i class="bi bi-arrow-left"></i>
    Quay lại
</button>

<script>
    function quayLai() {
        const trangTruoc = sessionStorage.getItem("trangTruocChamCong");

        if (trangTruoc &&
            new URL(trangTruoc).origin === window.location.origin) {
            window.location.href = trangTruoc;
        } else {
            window.location.href = '@Url.Action("Index", "Home")';
        }
    }
</script>

        <a asp-controller="ChamCong"
           asp-action="Create"
           class="btn btn-success">
            <i class="bi bi-camera"></i>
            Chấm công
        </a>
    </div>
</div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    <!-- BỘ LỌC -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <form asp-action="Index"
                  method="get"
                  class="row g-3 align-items-end">

                <div class="col-md-3">
                    <label class="form-label fw-bold">
                        Ngày
                    </label>

                    <input type="date"
                           name="ngay"
                           value="@ViewBag.Ngay"
                           class="form-control" />
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-bold">
                        Tháng
                    </label>

                    <select name="thang"
                            class="form-select">

                        <option value="">-- Tất cả --</option>

                        @for (int i = 1; i <= 12; i++)
                        {
                            if (ViewBag.Thang != null &&
                                (int)ViewBag.Thang == i)
                            {
                                <option value="@i" selected>
                                    Tháng @i
                                </option>
                            }
                            else
                            {
                                <option value="@i">
                                    Tháng @i
                                </option>
                            }
                        }

                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-bold">
                        Năm
                    </label>

                    <select name="nam"
                            class="form-select">

                        <option value="">-- Tất cả --</option>

                        @for (
                            int i = DateTime.Now.Year - 2;
                            i <= DateTime.Now.Year + 1;
                            i++)
                        {
                            if (ViewBag.Nam != null &&
                                (int)ViewBag.Nam == i)
                            {
                                <option value="@i" selected>
                                    @i
                                </option>
                            }
                            else
                            {
                                <option value="@i">
                                    @i
                                </option>
                            }
                        }

                    </select>
                </div>

                <div class="col-md-2">
                    <button type="submit"
                            class="btn btn-primary w-100">
                        <i class="bi bi-search"></i>
                        Lọc
                    </button>
                </div>

                <div class="col-md-2">
                    <a asp-action="Index"
                       class="btn btn-outline-secondary w-100">
                        <i class="bi bi-arrow-clockwise"></i>
                        Xóa lọc
                    </a>
                </div>

            </form>

        </div>
    </div>

    <!-- BẢNG -->
    <div class="card shadow-sm">

        <div class="card-header bg-dark text-white">
            <strong>
                Danh sách chấm công
            </strong>
        </div>

        <div class="card-body p-0">

            @if (Model == null || Model.Count == 0)
            {
                <div class="alert alert-info m-3">
                    Chưa có dữ liệu chấm công.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover table-bordered mb-0">

                        <thead class="table-dark">

                            <tr>
                                <th>ID</th>
                                <th>Nhân viên</th>
                                <th>Ngày</th>
                                <th>Giờ</th>
                                <th>Vị trí</th>
                                <th>Tọa độ</th>
                                <th>Ảnh</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @item.ChamCongId
                                    </td>

                                    <td>
                                        <strong>
                                            @(item.HoTenNhanVien
                                                ?? "Nhân viên #" +
                                                item.NhanVienId)
                                        </strong>
                                    </td>

                                    <td>
    @item.ThoiGianChamCong.ToString("dd/MM/yyyy")
</td>

<td>
    <span class="badge bg-primary">
        @item.ThoiGianChamCong.ToString("HH:mm:ss")
    </span>
</td>

                                    <td>
                                        @(item.ViTri ?? "Không có")
                                    </td>

                                    <td>
                                        <small>
                                            @item.Latitude
                                            <br />
                                            @item.Longitude
                                        </small>
                                    </td>

                                    
<td class="text-center">
    @if (!string.IsNullOrWhiteSpace(item.HinhAnh))
    {
        var imageUrl = item.HinhAnh.Trim();
        const string apiBaseUrl = "https://localhost:7151";

        var duplicatePrefix = apiBaseUrl + "/" + apiBaseUrl + "/";

        while (imageUrl.StartsWith(
            duplicatePrefix,
            StringComparison.OrdinalIgnoreCase))
        {
            imageUrl = apiBaseUrl + "/" +
                imageUrl.Substring(duplicatePrefix.Length);
        }

        if (imageUrl.StartsWith("/Images/",
            StringComparison.OrdinalIgnoreCase))
        {
            imageUrl = apiBaseUrl + imageUrl;
        }
        else if (imageUrl.StartsWith("Images/",
            StringComparison.OrdinalIgnoreCase))
        {
            imageUrl = apiBaseUrl + "/" + imageUrl;
        }
        else if (!Uri.IsWellFormedUriString(
            imageUrl, UriKind.Absolute))
        {
            imageUrl = apiBaseUrl + "/" +
                imageUrl.TrimStart('/');
        }

        <a href="@imageUrl"
           target="_blank"
           rel="noopener noreferrer">
            <img src="@imageUrl"
                 alt="Ảnh chấm công"
                 style="width:120px;height:90px;object-fit:cover;border-radius:8px;border:1px solid #ddd;"
                 onerror="this.parentElement.style.display='none';" />
        </a>
    }
</td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>