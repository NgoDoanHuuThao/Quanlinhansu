@model List<QuanLyNhanSuMVC.Models.ThongBaoModel>

@{
    ViewData["Title"] = "Thông báo nội bộ";
    var role = Context.Session.GetString("Role");
    var coQuyenTao = role == "GiamDoc" || role == "TruongPhong";
}

<div class="container mt-4 mb-5">

    <!-- Tiêu đề -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        

        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-outline-secondary">
                ← Quay về trang chủ
            </a>
        </div>
    </div>
        <div>
            <h2 class="fw-bold mb-2">Thông báo nội bộ</h2>
            <p class="text-muted mb-0">
                Theo dõi và cập nhật các thông báo dành cho bạn.
            </p>
        </div>

        @if (coQuyenTao)
        {
            <a asp-controller="ThongBao"
               asp-action="Tao"
               class="btn btn-primary">
                + Tạo thông báo
            </a>
        }
    </div>

    <!-- Thông báo kết quả -->
    @if (TempData["ThongBao"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["ThongBao"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Đóng"></button>
        </div>
    }

    @if (TempData["ThongBaoLoi"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ThongBaoLoi"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Đóng"></button>
        </div>
    }

    @if (TempData["Loi"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["Loi"]
        </div>
    }

    @if (ViewBag.Loi != null)
    {
        <div class="alert alert-danger" role="alert">
            @ViewBag.Loi
        </div>
    }

    <!-- Thống kê -->
    @{
        var danhSach = Model ?? new List<QuanLyNhanSuMVC.Models.ThongBaoModel>();
        var tongSo = danhSach.Count;
        var soDaDoc = danhSach.Count(x => x.DaDoc);
        var soChuaDoc = tongSo - soDaDoc;
    }

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-2">Tổng thông báo</div>
                    <div class="fs-3 fw-bold">@tongSo</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-2">Đã đọc</div>
                    <div class="fs-3 fw-bold text-success">@soDaDoc</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-2">Chưa đọc</div>
                    <div class="fs-3 fw-bold text-warning">@soChuaDoc</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Danh sách thông báo -->
    @if (tongSo == 0)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <div class="display-5 mb-3">📭</div>
                <h5 class="fw-bold">Chưa có thông báo</h5>
                <p class="text-muted mb-0">
                    Thông báo mới sẽ xuất hiện tại đây.
                </p>
            </div>
        </div>
    }
    else
    {
        @foreach (var item in danhSach)
        {
            <div class="card border-0 shadow-sm mb-3
                @(item.DaDoc ? "" : "border-start border-4 border-primary")">

                <div class="card-body p-4">

                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                        <div class="flex-grow-1">
                            <h5 class="fw-bold mb-2">@item.TieuDe</h5>

                            <div class="small text-muted">
                                <span>Ngày tạo:</span>
                                @item.NgayTao.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>

                        @if (item.DaDoc)
                        {
                            <span class="badge bg-success">Đã đọc</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Chưa đọc</span>
                        }
                    </div>

                    <hr />

                    <div class="notification-content mb-3">@item.NoiDung</div>

                    @if (item.NgayHetHan.HasValue)
                    {
                        <div class="small text-muted mb-3">
                            Hết hạn:
                            @item.NgayHetHan.Value.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    }

                    @if (!item.DaDoc)
                    {
                        <form asp-controller="ThongBao"
                              asp-action="DaDoc"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@item.ThongBaoId" />

                            <button type="submit"
                                    class="btn btn-outline-success btn-sm">
                                ✓ Đánh dấu đã đọc
                            </button>
                        </form>
                    }
                </div>
            </div>
        }
    }

</div>

<style>
    .notification-content {
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        line-height: 1.7;
    }

    .card {
        border-radius: 12px;
    }

    .badge {
        font-size: 0.8rem;
        padding: 0.5rem 0.7rem;
    }
</style>
