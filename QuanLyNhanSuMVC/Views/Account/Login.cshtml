@model QuanLyNhanSuMVC.Models.LoginModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Đăng nhập - Quản lý nhân sự</title>

    <style>

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
                font-family: Arial, sans-serif;
                background: #f1f5f9;
            }

            .login-box {
                width: 400px;
                background: white;
                padding: 35px;
                border-radius: 15px;
                box-shadow: 0 10px 30px rgba(0,0,0,.12);
            }

            .logo {
                text-align: center;
                font-size: 28px;
                margin-bottom: 10px;
            }

            h2 {
                text-align: center;
                margin-bottom: 30px;
                color: #1e293b;
            }

            .form-group {
                margin-bottom: 18px;
            }

            label {
                display: block;
                margin-bottom: 7px;
                font-weight: bold;
                color: #334155;
            }

            input {
                width: 100%;
                padding: 12px;
                border: 1px solid #cbd5e1;
                border-radius: 8px;
                font-size: 15px;
            }

            input:focus {
                outline: none;
                border-color: #2563eb;
            }

            button {
                width: 100%;
                padding: 13px;
                border: none;
                border-radius: 8px;
                background: #2563eb;
                color: white;
                font-size: 16px;
                font-weight: bold;
                cursor: pointer;
            }

            button:hover {
                background: #1d4ed8;
            }

            .error {
                background: #fee2e2;
                color: #b91c1c;
                padding: 10px;
                border-radius: 8px;
                margin-bottom: 15px;
            }

    </style>

</head>

<body>

    <div class="login-box">

        <div class="logo">
            👥
        </div>

        <h2>
            Quản lý nhân sự
        </h2>

        @if (ViewBag.Error != null)
        {
            <div class="error">
                @ViewBag.Error
            </div>
        }

        <form asp-controller="Account"
              asp-action="Login"
              method="post">

            <div class="form-group">

                <label>
                    Tên đăng nhập
                </label>

                <input type="text"
                       asp-for="TenDangNhap"
                       placeholder="Nhập tên đăng nhập"
                       required />

            </div>

            <div class="form-group">

                <label>
                    Mật khẩu
                </label>

                <input type="password"
                       asp-for="MatKhau"
                       placeholder="Nhập mật khẩu"
                       required />

            </div>

            <button type="submit">
                Đăng nhập
            </button>

        </form>

    </div>

</body>

</html>