@model List<QuanLyNhanSuMVC.Models.TaiKhoanModel>

@{
    ViewData["Title"] = "Quản lý tài khoản";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-outline-secondary">
            ← Quay về trang chủ
        </a>
    </div>
</div>
        <div>
            <h2>Quản lý tài khoản</h2>
            <p class="text-muted">
                Quản lý tài khoản đăng nhập của nhân viên
            </p>
        </div>

        <a asp-controller="TaiKhoan"
           asp-action="Create"
           class="btn btn-primary">
            + Thêm tài khoản
        </a>
    </div>

    @if (TempData["TaiKhoanSuccess"] != null)
{
    <div class="alert alert-success">
        @TempData["TaiKhoanSuccess"]
    </div>
}

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Tên đăng nhập</th>
                            <th>Nhân viên</th>
                            <th>Vai trò</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.TaiKhoanId</td>

                                    <td>
                                        <strong>
                                            @item.TenDangNhap
                                        </strong>
                                    </td>

                                    <td>
                                        @(item.HoTenNhanVien ?? "Chưa liên kết")
                                    </td>

                                    <td>
                                        @if (item.VaiTro == "Giám đốc")
                                        {
                                            <span class="badge bg-danger">
                                                Giám đốc
                                            </span>
                                        }
                                        else if (item.VaiTro == "Trưởng phòng")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Trưởng phòng
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary">
                                                Nhân viên
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4"
                                    class="text-center text-muted">
                                    Chưa có tài khoản
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>