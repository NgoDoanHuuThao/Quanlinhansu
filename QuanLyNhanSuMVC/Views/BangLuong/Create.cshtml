@model QuanLyNhanSuMVC.Models.BangLuongFormModel

@{
    ViewData["Title"] = "Thêm bảng lương";

    var nhanViens =
        ViewBag.NhanViens as List<QuanLyNhanSuMVC.Models.NhanVienModel>
        ?? new List<QuanLyNhanSuMVC.Models.NhanVienModel>();
}

<div class="container mt-4">

    <div class="mb-4">
        <h2>➕ Thêm bảng lương</h2>

        <p class="text-muted">
            Tạo bảng lương cho nhân viên
        </p>
    </div>


    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @Html.ValidationSummary(false)
        </div>
    }


    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- NHÂN VIÊN -->

                <div class="mb-3">

                    <label asp-for="NhanVienId"
                           class="form-label">
                        Nhân viên
                    </label>

                    <select asp-for="NhanVienId"
                            class="form-select"
                            required>

                        <option value="0">
                            -- Chọn nhân viên --
                        </option>

                        @foreach (var nv in nhanViens)
                        {
                            <option value="@nv.NhanVienId">
                                @nv.HoTen
                            </option>
                        }

                    </select>

                    <span asp-validation-for="NhanVienId"
                          class="text-danger">
                    </span>

                </div>


                <!-- THÁNG + NĂM -->

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="Thang"
                               class="form-label">
                            Tháng
                        </label>

                        <input asp-for="Thang"
                               type="number"
                               class="form-control"
                               min="1"
                               max="12"
                               required />

                        <span asp-validation-for="Thang"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="Nam"
                               class="form-label">
                            Năm
                        </label>

                        <input asp-for="Nam"
                               type="number"
                               class="form-control"
                               min="2000"
                               max="2100"
                               required />

                        <span asp-validation-for="Nam"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- LƯƠNG CƠ BẢN -->

                <div class="mb-3">

                    <label class="form-label">
                        Lương cơ bản
                    </label>

                    <input asp-for="LuongCoBan"
                           type="number"
                           class="form-control"
                           min="0"
                           step="1000"
                           placeholder="Nhập lương cơ bản" />

                </div>


                <!-- PHỤ CẤP -->

                <div class="mb-3">

                    <label class="form-label">
                        Phụ cấp
                    </label>

                    <input asp-for="PhuCap"
                           type="number"
                           class="form-control"
                           min="0"
                           step="1000"
                           placeholder="Nhập phụ cấp" />

                </div>


                <!-- THƯỞNG -->

                <div class="mb-3">

                    <label class="form-label">
                        Thưởng
                    </label>

                    <input asp-for="Thuong"
                           type="number"
                           class="form-control"
                           min="0"
                           step="1000"
                           placeholder="Nhập thưởng" />

                </div>


                <div class="alert alert-info">

                    ℹ️ <strong>Lưu ý:</strong>

                    Khi lưu bảng lương, hệ thống API hiện tại
                    sẽ lấy Lương cơ bản, Phụ cấp và Thưởng
                    từ thông tin của nhân viên trong bảng
                    <strong>NhanViens</strong>.

                </div>


                <!-- BUTTON -->

                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-success">
                        💾 Lưu bảng lương
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        ← Quay lại
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>