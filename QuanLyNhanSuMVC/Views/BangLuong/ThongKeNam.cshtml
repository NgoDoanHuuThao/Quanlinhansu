@model List<QuanLyNhanSuMVC.Models.ThongKeLuongNamModel>

@{
    ViewData["Title"] = "Thống kê lương theo năm";

    int nam = DateTime.Now.Year;

    if (ViewBag.Nam != null)
    {
        nam = Convert.ToInt32(ViewBag.Nam);
    }

    var danhSach =
        Model ?? new List<QuanLyNhanSuMVC.Models.ThongKeLuongNamModel>();

    double tongNam = 0;
    double maxLuong = 0;

    foreach (var item in danhSach)
    {
        if (item != null)
        {
            tongNam += item.TongQuyLuong;

            if (item.TongQuyLuong > maxLuong)
            {
                maxLuong = item.TongQuyLuong;
            }
        }
    }
}

<div class="container mt-4">

    <!-- TIÊU ĐỀ -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>📈 Thống kê lương theo năm</h2>

            <p class="text-muted">
                Theo dõi tổng quỹ lương từng tháng
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="ThongKe"
               class="btn btn-info text-white">
                📊 Thống kê tháng
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                ← Quay lại
            </a>

        </div>

    </div>


    <!-- LỖI -->

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            ❌ @ViewBag.Error
        </div>
    }


    <!-- CHỌN NĂM -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <form asp-action="ThongKeNam"
                  method="get">

                <div class="row align-items-end">

                    <div class="col-md-8">

                        <label class="form-label">
                            Năm
                        </label>

                        <input type="number"
                               name="nam"
                               value="@nam"
                               min="2000"
                               max="2100"
                               class="form-control" />

                    </div>

                    <div class="col-md-4">

                        <button type="submit"
                                class="btn btn-primary w-100">
                            🔍 Xem thống kê
                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- TỔNG QUỸ LƯƠNG -->

    <div class="card shadow-sm mb-4">

        <div class="card-body text-center">

            <div class="text-muted">
                Tổng quỹ lương năm @nam
            </div>

            <h1 class="text-success mt-2">
                @tongNam.ToString("N0") đ
            </h1>

        </div>

    </div>


    <!-- BIỂU ĐỒ -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h4 class="mb-4">
                📊 Quỹ lương từng tháng
            </h4>

            @foreach (var item in danhSach)
            {
                double percent = 0;

                if (maxLuong > 0)
                {
                    percent =
                        item.TongQuyLuong
                        / maxLuong
                        * 100;
                }

                <div class="mb-3">

                    <div class="d-flex justify-content-between mb-1">

                        <strong>
                            Tháng @item.Thang
                        </strong>

                        <span>
                            @item.TongQuyLuong.ToString("N0") đ
                        </span>

                    </div>

                    <div class="progress"
                         style="height:25px;">

                        <div class="progress-bar"
                             role="progressbar"
                             style="width:@percent.ToString(
                                 System.Globalization.CultureInfo.InvariantCulture)%">

                            @if (item.TongQuyLuong > 0)
                            {
                                @item.TongQuyLuong.ToString("N0") @:đ
                            }

                        </div>

                    </div>

                </div>
            }

        </div>

    </div>


    <!-- BẢNG CHI TIẾT -->

    <div class="card shadow-sm">

        <div class="card-body">

            <h4 class="mb-4">
                📋 Chi tiết từng tháng
            </h4>

            <div class="table-responsive">

                <table class="table table-bordered table-hover">

                    <thead class="table-dark">

                        <tr>

                            <th>
                                Tháng
                            </th>

                            <th>
                                Số nhân viên
                            </th>

                            <th class="text-end">
                                Lương cơ bản
                            </th>

                            <th class="text-end">
                                Phụ cấp
                            </th>

                            <th class="text-end">
                                Thưởng
                            </th>

                            <th class="text-end">
                                Tổng quỹ lương
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in danhSach)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        Tháng @item.Thang
                                    </strong>
                                </td>

                                <td>
                                    @item.SoNhanVien
                                </td>

                                <td class="text-end">
                                    @item.TongLuongCoBan.ToString("N0") đ
                                </td>

                                <td class="text-end">
                                    @item.TongPhuCap.ToString("N0") đ
                                </td>

                                <td class="text-end">
                                    @item.TongThuong.ToString("N0") đ
                                </td>

                                <td class="text-end">

                                    @if (item.TongQuyLuong > 0)
                                    {
                                        <strong class="text-success">
                                            @item.TongQuyLuong.ToString("N0") đ
                                        </strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Chưa có dữ liệu
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                    <tfoot>

                        <tr class="table-success">

                            <th>
                                TỔNG CẢ NĂM
                            </th>

                            <th>
                                @danhSach.Sum(x => x.SoNhanVien)
                            </th>

                            <th class="text-end">
                                @danhSach.Sum(x => x.TongLuongCoBan).ToString("N0") đ
                            </th>

                            <th class="text-end">
                                @danhSach.Sum(x => x.TongPhuCap).ToString("N0") đ
                            </th>

                            <th class="text-end">
                                @danhSach.Sum(x => x.TongThuong).ToString("N0") đ
                            </th>

                            <th class="text-end">
                                @tongNam.ToString("N0") đ
                            </th>

                        </tr>

                    </tfoot>

                </table>

            </div>

        </div>

    </div>

</div>