@model QuanLyNhanSuMVC.Models.BangLuongModel

@{
    ViewData["Title"] = "Chi tiết bảng lương";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2>💰 Chi tiết bảng lương</h2>

        <p class="text-muted">
            Thông tin chi tiết bảng lương nhân viên
        </p>
    </div>


    <div class="card shadow-sm">

        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">
                📋 Thông tin bảng lương
            </h5>
        </div>


        <div class="card-body">

            <!-- ID -->

            <div class="row mb-3">

                <div class="col-md-4">
                    <strong>Mã bảng lương</strong>
                </div>

                <div class="col-md-8">
                    @Model.BangLuongId
                </div>

            </div>


            <hr />


            <!-- NHÂN VIÊN -->

            <div class="row mb-3">

                <div class="col-md-4">
                    <strong>Nhân viên</strong>
                </div>

                <div class="col-md-8">

                    <strong>
                        @(Model.HoTenNhanVien ?? "Không xác định")
                    </strong>

                </div>

            </div>


            <!-- THÁNG -->

            <div class="row mb-3">

                <div class="col-md-4">
                    <strong>Tháng</strong>
                </div>

                <div class="col-md-8">
                    @Model.Thang
                </div>

            </div>


            <!-- NĂM -->

            <div class="row mb-3">

                <div class="col-md-4">
                    <strong>Năm</strong>
                </div>

                <div class="col-md-8">
                    @Model.Nam
                </div>

            </div>


            <hr />


            <!-- LƯƠNG CƠ BẢN -->

            <div class="row mb-3">

                <div class="col-md-4">
                    <strong>Lương cơ bản</strong>
                </div>

                <div class="col-md-8">

                    @((Model.LuongCoBan ?? 0).ToString("N0")) đ

                </div>

            </div>


            <!-- PHỤ CẤP -->

            <div class="row mb-3">

                <div class="col-md-4">
                    <strong>Phụ cấp</strong>
                </div>

                <div class="col-md-8">

                    @((Model.PhuCap ?? 0).ToString("N0")) đ

                </div>

            </div>


            <!-- THƯỞNG -->

            <div class="row mb-3">

                <div class="col-md-4">
                    <strong>Thưởng</strong>
                </div>

                <div class="col-md-8">

                    @((Model.Thuong ?? 0).ToString("N0")) đ

                </div>

            </div>


            <!-- TỔNG LƯƠNG -->

            <div class="row mb-3">

                <div class="col-md-4">
                    <strong>Tổng lương</strong>
                </div>

                <div class="col-md-8">

                    <h4 class="text-success mb-0">

                        @((Model.TongLuong ?? 0).ToString("N0")) đ

                    </h4>

                </div>

            </div>


        </div>


        <!-- FOOTER -->

        <div class="card-footer">

            <a asp-action="Index"
               class="btn btn-secondary">
                ← Quay lại
            </a>

            @if (Context.Session.GetString("Role") == "GiamDoc")
            {
                <a asp-action="Edit"
                   asp-route-id="@Model.BangLuongId"
                   class="btn btn-warning">
                    ✏️ Sửa
                </a>
            }

        </div>

    </div>

</div>